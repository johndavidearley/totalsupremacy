{
  "version": 1,
  "require_idle": true,
  "steps": [
    {"assert": {"field": "unit_count", "op": "eq", "expected": 1000}},
    {"assert": {"field": "tick", "op": "eq", "expected": 0}},
    {"assert": {"field": "paused", "op": "eq", "expected": true}},
    {"assert": {"field": "selected_count", "op": "eq", "expected": 0}},
    {"command": "move", "args": {"x": 500, "z": 500}, "expected_error": "select one or more units before issuing a move"},
    {"command": "pause", "args": {"paused": false}},
    {"command": "advance", "args": {"ticks": 1}, "expected_error": "pause the simulation before advancing explicit ticks"},
    {"command": "pause", "args": {"paused": true}},
    {"command": "select", "args": {"id": 1}},
    {"assert": {"field": "selected_count", "op": "eq", "expected": 1}},
    {"command": "move", "args": {"x": 700, "z": 500}},
    {"assert": {"field": "last_move.units_ordered", "op": "eq", "expected": 1}},
    {"assert": {"field": "last_move.units_routed", "op": "eq", "expected": 1}},
    {"command": "advance", "args": {"ticks": 1200}},
    {"assert": {"section": "units", "query": {"offset": 0, "limit": 2}, "field": "units.0.path_remaining", "op": "eq", "expected": 0}},
    {"assert": {"section": "units", "query": {"offset": 0, "limit": 2}, "field": "units.1.x", "op": "eq", "expected": 406}},
    {"assert": {"section": "units", "query": {"offset": 0, "limit": 2}, "field": "units.1.z", "op": "eq", "expected": 250}},
    {"command": "select_units", "args": {"first": 1, "count": 16}},
    {"command": "move", "args": {"x": 1000, "z": 700}},
    {"assert": {"field": "last_move.units_routed", "op": "eq", "expected": 16}},
    {"assert": {"section": "units", "query": {"offset": 0, "limit": 2}, "field": "units.0.target_x", "op": "lt", "expected": 990}},
    {"assert": {"section": "units", "query": {"offset": 0, "limit": 2}, "field": "units.1.target_x", "op": "gt", "expected": 990}},
    {"command": "advance", "args": {"ticks": 30}},
    {"command": "move", "args": {"x": 1500, "z": 900}},
    {"assert": {"field": "last_move.units_routed", "op": "eq", "expected": 16}},
    {"assert": {"field": "last_move.issued_at_tick", "op": "gt", "expected": 0}},
    {"command": "advance", "args": {"ticks": 2400}},
    {"assert": {"section": "units", "query": {"offset": 0, "limit": 1}, "field": "units.0.path_remaining", "op": "eq", "expected": 0}},
    {"assert": {"section": "units", "query": {"offset": 15, "limit": 1}, "field": "units.0.path_remaining", "op": "eq", "expected": 0}},
    {"command": "select_units", "args": {"first": 1, "count": 64}},
    {"command": "move", "args": {"x": 35, "z": 38.5}},
    {"assert": {"field": "last_move.units_routed", "op": "eq", "expected": 64}},
    {"command": "advance", "args": {"ticks": 3600}},
    {"assert": {"section": "units", "query": {"offset": 0, "limit": 1}, "field": "units.0.path_remaining", "op": "eq", "expected": 0}},
    {"assert": {"section": "units", "query": {"offset": 63, "limit": 1}, "field": "units.0.path_remaining", "op": "eq", "expected": 0}},
    {"command": "select_units", "args": {"first": 1, "count": 1000}},
    {"assert": {"field": "selected_count", "op": "eq", "expected": 1000}},
    {"command": "move", "args": {"x": 1800, "z": 1300}},
    {"assert": {"field": "last_move.units_ordered", "op": "eq", "expected": 1000}},
    {"assert": {"field": "last_move.units_routed", "op": "eq", "expected": 1000}},
    {"command": "advance", "args": {"ticks": 4800}},
    {"assert": {"section": "units", "query": {"offset": 0, "limit": 1}, "field": "units.0.path_remaining", "op": "eq", "expected": 0}},
    {"assert": {"section": "units", "query": {"offset": 999, "limit": 1}, "field": "units.0.path_remaining", "op": "eq", "expected": 0}},
    {"command": "camera", "args": {"yaw": 40, "pitch": 55, "scale": 0.6, "focus_x": 1200, "focus_z": 800, "perspective": true}},
    {"assert": {"field": "camera.perspective", "op": "eq", "expected": true}},
    {"assert": {"field": "camera.focus_x", "op": "gt", "expected": 1199}},
    {"assert": {"field": "camera.focus_x", "op": "lt", "expected": 1201}},
    {"command": "select", "args": {"id": 999999}, "expected_error": "unit id was not found"},
    {"assert": {"field": "unit_count", "op": "eq", "expected": 1000}}
  ]
}
