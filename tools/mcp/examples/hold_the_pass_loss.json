    {"command": "move", "args": {"x": 560, "z": 650}},
    {"command": "advance", "args": {"ticks": 60}},
    {"assert": {"section": "units", "field": "units.2.z", "op": "gt", "expected": 620}},
    {"assert": {"field": "objective.hold_ticks", "op": "eq", "expected": 0}},
    {"command": "advance", "args": {"ticks": 420}},
    {"assert": {"field": "objective.status", "op": "eq", "expected": "defeat"}},
    {"assert": {"field": "objective.hold_ticks", "op": "eq", "expected": 0}}
  ]
